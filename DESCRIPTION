Package: M2ara
Title: A shiny GUI to explore concentration-responses in MALDI-based assays
Version: 1.6.0
Authors@R: 
    person("Thomas", "Enzlein", , "t.enzlein@hs-mannheim.de", role = c("aut", "cre"),
